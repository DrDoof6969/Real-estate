# Copy to .env.local for `vercel dev`, and set the same values in your
# hosting dashboard (Vercel: Settings -> Environment Variables) for the
# deployed site. Never commit the filled-in version.

# ============================================================
# REQUIRED
# ============================================================

# https://app.rentcast.io/app/api
# NOTE: every fresh lookup spends THREE RentCast calls (property records,
# value AVM, rent AVM). Size your plan against calls, not lookups.
RENTCAST_API_KEY=

# ============================================================
# REQUIRED FOR PUBLIC TRAFFIC
# (the site runs without these, but not safely — see README)
# ============================================================

# Shared cache + real distributed rate limiting + the spend caps.
# Without these there is NO site-wide budget ceiling at all and rate
# limiting degrades to a per-instance counter that resets on every cold
# start. Free tier at upstash.com covers this comfortably.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — the only thing that actually stops a script from
# draining your API budget. Free, no usage cap. Required in production by
# default; set TURNSTILE_REQUIRED=false to deploy without it anyway.
# Both keys come from the same Cloudflare dashboard page.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# TURNSTILE_REQUIRED=false

# Your own domains, comma-separated. Stops another site pointing its
# frontend at your /api/lookup and spending your budget. Leave empty and
# any origin is accepted.
# e.g. https://dealqualifier.com,https://www.dealqualifier.com
ALLOWED_ORIGINS=

# Gates /api/stats and the &debug=1 raw provider output. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# ============================================================
# OPTIONAL FEATURES
# ============================================================

# Address-autocomplete dropdown. https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# Second, independent rent estimate to cross-check RentCast's.
RENTOMETER_API_KEY=

# Slack or Discord incoming webhook. Gets a message when the spend budget
# is exhausted, a provider goes down, or cache writes start failing.
ALERT_WEBHOOK_URL=

# ============================================================
# LIMITS AND BUDGETS (defaults shown)
# ============================================================

# Per-visitor. The burst limit is the one that stops a script; the daily
# limit is only consumed on a cache MISS, so looking up addresses someone
# else already looked up doesn't count against a visitor.
LOOKUP_LIMIT_PER_IP_PER_MINUTE=5
LOOKUP_DAILY_LIMIT_PER_IP=20

# Site-wide ceilings on FRESH (billable) lookups across all visitors.
# Multiply by 3 to get RentCast calls. Only enforced when Upstash is set.
# The defaults below are sized for a paid plan — on RentCast's free tier
# (50 calls/month total) set DAILY to 1 and MONTHLY to 16.
DAILY_GLOBAL_LOOKUP_LIMIT=200
MONTHLY_GLOBAL_LOOKUP_LIMIT=5000

# How long a looked-up address is reused for the next visitor. The single
# biggest cost lever on the site.
LOOKUP_CACHE_TTL_SECONDS=259200
# "No data for this address" is also a real answer worth caching.
LOOKUP_NEGATIVE_CACHE_TTL_SECONDS=86400

AUTOCOMPLETE_LIMIT_PER_IP_PER_MINUTE=60
AUTOCOMPLETE_DAILY_LIMIT_PER_IP=500
AUTOCOMPLETE_CACHE_TTL_SECONDS=604800
AUTOCOMPLETE_EDGE_TTL_SECONDS=3600

# ============================================================
# TIMEOUTS (defaults shown) — rarely need changing
# ============================================================
PROVIDER_TIMEOUT_MS=8000
PROVIDER_MAX_ATTEMPTS=3
UPSTASH_TIMEOUT_MS=2000
TURNSTILE_TIMEOUT_MS=4000
