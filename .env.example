# --- Required ---
# https://app.rentcast.io/app/api  (free tier: 50 requests/mo)
RENTCAST_API_KEY=

# --- Optional: address autocomplete ---
# https://account.mapbox.com/access-tokens/  (free: 50k non-session Search Box req/mo)
MAPBOX_TOKEN=

# --- Optional: second rent-comp source ---
RENTOMETER_API_KEY=

# --- Optional: shared cache + real distributed rate limiting + global spend cap ---
# Copy both verbatim from the Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: bot check before a lookup spends an API call ---
TURNSTILE_SECRET_KEY=

# --- Tunables (defaults shown) ---
LOOKUP_DAILY_LIMIT_PER_IP=20
DAILY_GLOBAL_LOOKUP_LIMIT=200
LOOKUP_CACHE_TTL_SECONDS=259200
AUTOCOMPLETE_DAILY_LIMIT_PER_IP=500

# Note: TURNSTILE_SITE_KEY is NOT an env var — it is a public key that goes
# directly into index.html (const TURNSTILE_SITE_KEY near the top of the
# <script> block, ~line 1000). Only the SECRET key belongs here.
